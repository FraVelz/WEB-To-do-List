# URL pública del sitio (Open Graph, metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Firebase — cliente (público). Opcional en Lab: el modo demo no lo usa.
# Demo data lives in browser localStorage only (see docs/adr/0002-demo-store-isolation.md).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Firebase Admin — servidor (Project settings → Service accounts)
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Opción B: campos sueltos del JSON de service account
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
